# --- Gemini (pick ONE) ---
# Option A: Vertex AI (recommended on Cloud Run; uses the service account, no key needed)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Option B: Gemini Developer API key (local dev)
# GOOGLE_API_KEY=...

GEMINI_MODEL=gemini-2.5-flash
RATE_LIMIT_PER_MIN=40
# Set to 1 to force rules-only mode (no Google API calls)
KARAR_OFFLINE=0
